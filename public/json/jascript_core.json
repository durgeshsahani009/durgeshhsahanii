      "id":"6",
      "que":"JavaScript 'window.location' methods?",
       "order":["paragraph", "list"],
      "ans":{
        "paragraph": ["For the given full url <b class='marker'>https://example.com:8080/path?user=1&role=admin#top</b>,\n we can break up all component as follow:"],
        "subTitle":[],
        "list":[       
          {"title":"window.location.href", "marker":"<span class='highlight'>https://example.com:8080/path?user=1&role=admin</span>"},
          {"title":"window.location.protocol", "marker":"<span class='highlight'>https:</span>//example.com:8080/path?user=1&role=admin"},
          {"title":"window.location.hostname", "marker":"https://<span class='highlight'>example.com</span>:8080/path?user=1&role=admin"},
          {"title":"window.location.host", "marker":"https://<span class='highlight'>example.com:8080</span>/path?user=1&role=admin"},
          {"title":"window.location.origin", "marker":"<span class='highlight'>https://example.com:8080</span>/path?user=1&role=admin"},
          {"title":"window.location.port", "marker":"https://example.com:<span class='highlight'>8080</span>/path?user=1&role=admin"},
          {"title":"window.location.pathname", "marker":"https://example.com:8080/<span class='highlight'>path</span>?user=1&role=admin"},
          {"title":"window.location.search", "marker":"https://example.com:8080/path?<span class='highlight'>user=1&role=admin</span>"},
          {"title":"window.location.hash", "marker":"https://example.com:8080/path?user=1&role=admin<span class='highlight'>#top</span>"}
